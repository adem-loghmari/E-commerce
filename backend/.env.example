# Copy this file to .env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/e-commerce
# Long random string, for example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
ADMIN_USERNAME=admin
# bcrypt hash of the admin password: node -e "require('bcrypt').hash('yourpassword', 12).then(console.log)"
ADMIN_PASSWORD_HASH=
# Origin allowed to call the API from a browser. Leave empty when the backend serves both apps itself.
CORS_ORIGIN=
PORT=4000
